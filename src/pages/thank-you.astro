---
import BaseLayout from '../layouts/BaseLayout.astro';
import { company, links } from '../lib/content';
---
<BaseLayout title={`Thank you | ${company.company.name}`} noindex>
  <main id="main" class="section--dark" style="min-height:100vh;display:grid;place-items:center;padding:32px 20px">
    <div style="max-width:560px">
      <p class="eyebrow" style="color:var(--blue)">Enquiry received</p>
      <h1 style="color:#fff;font-size:2.25rem;line-height:1.15;margin-top:14px">Thank you. We have received your enquiry.</h1>
      <p style="color:#b6c2cf;margin-top:16px">We will review it and get in touch. For anything urgent, call or message us directly.</p>
      <div class="btn-row" style="margin-top:28px">
        <a class="btn btn--wa" href={links.whatsapp} target="_blank" rel="noopener">WhatsApp</a>
        <a class="btn btn--ghost" href={links.tel}>Call {company.contact.phoneDisplay}</a>
        <a class="btn btn--ghost" href="/">Back to home</a>
      </div>
    </div>
  </main>
</BaseLayout>
