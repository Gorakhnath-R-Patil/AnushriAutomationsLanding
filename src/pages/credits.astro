---
import BaseLayout from '../layouts/BaseLayout.astro';
import { company, photos } from '../lib/content';
---
<BaseLayout title={`Image credits | ${company.company.name}`}>
  <main id="main" class="section--dark" style="min-height:100vh;padding:56px 20px">
    <div class="container" style="max-width:760px">
      <a href="/" style="color:var(--blue)">← Back to home</a>
      <h1 style="color:#fff;font-size:2rem;margin-top:20px">Image credits</h1>
      <p style="color:#b6c2cf;margin-top:12px">The photographs on this website are illustrative stock images from Wikimedia Commons. They are not photographs of Anushri Systems projects. Product and brand names shown belong to their respective owners and do not imply any partnership.</p>
      <ul style="margin-top:28px;display:grid;gap:18px">
        {photos.map((p) => (
          <li style="color:#cdd7e2"><strong style="color:#fff">{p.caption}</strong><br />
            “<a href={p.source} rel="noopener" target="_blank" style="color:var(--blue)">{p.source.split('File:')[1]?.replace(/_/g, ' ')}</a>” by {p.author}, licensed <a href={p.licenseUrl} rel="noopener" target="_blank" style="color:var(--blue)">{p.license}</a>. Resized and compressed for the web.</li>
        ))}
      </ul>
    </div>
  </main>
</BaseLayout>
