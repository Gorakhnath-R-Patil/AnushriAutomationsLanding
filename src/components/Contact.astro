---
import Icon from './Icon.astro';
import { site, company, links } from '../lib/content';
const c = site.contact;
---
<section id="contact" class="section section--white" aria-labelledby="contact-title" data-wa-msg={links.waText('contact')}>
  <div class="container">
    <div class="section-head reveal">
      <span class="eyebrow">{c.eyebrow}</span>
      <h2 class="h2" id="contact-title">{c.heading}</h2>
    </div>
    <div class="contact">
      <div class="contact__card reveal">
        <div class="contact__row"><Icon name="pin" /><div><small>Location</small><strong>{company.company.name}</strong><br />{company.location.display}</div></div>
        <div class="contact__row"><Icon name="phone" /><div><small>Phone</small><a href={links.tel}>{company.contact.phoneDisplay}</a></div></div>
        <div class="contact__row"><Icon name="whatsapp" /><div><small>WhatsApp</small><a href={links.waFor('contact')} target="_blank" rel="noopener">{company.contact.phoneDisplay}</a></div></div>
        <div class="contact__row"><Icon name="mail" /><div><small>Email</small><a href={links.mailto}>{company.contact.email}</a></div></div>
        <div class="btn-row">
          <a class="btn btn--primary" href={links.tel}><Icon name="phone" />Call Us</a>
          <a class="btn btn--wa" href={links.waFor('contact')} target="_blank" rel="noopener"><Icon name="whatsapp" />WhatsApp</a>
          <a class="btn btn--ghost" href={links.mailto}><Icon name="mail" />Send Email</a>
        </div>
      </div>
      <div class="reveal" style="--d:100ms">
        <div class="map" data-map data-src={links.mapEmbed} data-title={`Map of the ${company.location.locality}, ${company.location.district} area`}>
          <div class="map__placeholder grid-bg">
            <Icon name="pin" class="" />
            <strong>{company.location.locality}, {company.location.district}</strong>
            <p>Map of the {company.location.locality} area. It loads when you tap the button, to keep the page fast.</p>
            <div class="btn-row" style="justify-content:center">
              <button class="btn btn--primary btn--sm" type="button" data-map-load>Load map</button>
              <a class="btn btn--ghost btn--sm" href={links.directions} target="_blank" rel="noopener">Get Directions</a>
            </div>
          </div>
        </div>
        <p class="map__caption">Map shows the {company.location.locality} area only, not an exact office location. Exact address to be added.</p>
      </div>
    </div>
  </div>
</section>
